<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Job files with photos can exceed the 25 MB cloud quota, so cloud backup stays
     off until sync exists; moving to a new phone transfers everything. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
