{
  "version": 10,
  "cmakeMinimumRequired": { "major": 4, "minor": 0, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON"
      }
    },
    {
      "name": "desktop",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": { "VCPKG_MANIFEST_FEATURES": "tests" }
    },
    {
      "name": "desktop-debug",
      "inherits": "desktop",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "desktop-asan",
      "displayName": "Desktop Debug with AddressSanitizer + UndefinedBehaviorSanitizer",
      "inherits": "desktop",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "OTVES_SANITIZERS": "address;undefined" }
    },
    {
      "name": "desktop-tsan",
      "displayName": "Desktop Debug with ThreadSanitizer",
      "inherits": "desktop",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "OTVES_SANITIZERS": "thread" }
    },
    {
      "name": "desktop-release",
      "inherits": "desktop",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "android-arm64",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-android",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-29",
        "ANDROID_STL": "c++_static",
        "OTVES_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "android-arm64-debug",
      "displayName": "Android arm64 Debug with HWAddressSanitizer",
      "inherits": "android-arm64",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "OTVES_SANITIZERS": "hwaddress" }
    },
    {
      "name": "android-arm64-release",
      "inherits": "android-arm64",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "desktop-debug", "configurePreset": "desktop-debug" },
    { "name": "desktop-asan", "configurePreset": "desktop-asan" },
    { "name": "desktop-tsan", "configurePreset": "desktop-tsan" },
    { "name": "desktop-release", "configurePreset": "desktop-release" },
    { "name": "android-arm64-debug", "configurePreset": "android-arm64-debug" },
    { "name": "android-arm64-release", "configurePreset": "android-arm64-release" }
  ],
  "testPresets": [
    {
      "name": "desktop-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "desktop-debug", "inherits": "desktop-base", "configurePreset": "desktop-debug" },
    { "name": "desktop-asan", "inherits": "desktop-base", "configurePreset": "desktop-asan" },
    { "name": "desktop-tsan", "inherits": "desktop-base", "configurePreset": "desktop-tsan" }
  ]
}
