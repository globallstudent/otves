// The contract between the Kotlin app and the C++ engine (docs/adr/0006). Add fields only at
// the end of a table, with a default; never renumber, retype or remove one: deprecate it. Enum
// values never change once released. Lengths are whole millimetres.

namespace otves.schema;

file_identifier "OTVS";

struct Uuid {
  high:ulong;
  low:ulong;
}

struct PointMm {
  x:long;
  y:long;
}

enum LocationLine:ubyte { Center = 0, LeftFace = 1, RightFace = 2 }

enum OpeningKind:ubyte { Window = 0, Door = 1, Empty = 2 }

enum WallEnd:ubyte { Start = 0, End = 1 }

table Level {
  elevation:long;
  height:long;
  ring_beam:long;        // height of the beam on the load-bearing walls; 0 for none (docs/adr/0008)
  junction_meshes:bool;  // meshes where load-bearing walls meet
  // The section of the strip footing under the load-bearing walls; both 0 for none (docs/adr/0010).
  footing_width:long;
  footing_depth:long;
}

table Wall {
  level:Uuid;
  start:PointMm;
  end:PointMm;
  thickness:long;
  height:long;
  location_line:LocationLine = Center;
  // The masonry unit as laid; all 0 until chosen (docs/adr/0008).
  unit_length:long;
  unit_width:long;
  unit_height:long;
  // Whether the length was typed or measured. A wall read from a sketch is not, until it gets a
  // length (docs/adr/0012).
  exact:bool = true;
}

table Opening {
  wall:Uuid;
  offset:long;
  width:long;
  height:long;
  sill:long;
  kind:OpeningKind = Window;
}

// What the job is estimated under (docs/adr/0009); -1 leaves a value to the norm default.
table Conditions {
  seismic_intensity:long = -1;  // points
  cement_grade:long = -1;       // 400 for ПЦ400
  mortar_grade:long = -1;       // 100 for М100
  unit_waste:long = -1;         // per mille
  mortar_waste:long = -1;       // per mille
}

enum ConditionsField:ubyte {
  SeismicIntensity = 0,
  CementGrade = 1,
  MortarGrade = 2,
  UnitWaste = 3,
  MortarWaste = 4,
}

// Sets one condition, creating the job's conditions when it has none.
table SetCondition { field:ConditionsField; value:long = -1; }

table AddLevel { level:Level; }
table SetLevelElevation { level:Uuid; elevation:long; }
table SetLevelHeight { level:Uuid; height:long; }
table RemoveLevel { level:Uuid; }
table SetLevelRingBeam { level:Uuid; height:long; }
table SetLevelJunctionMeshes { level:Uuid; meshes:bool; }
table SetLevelFooting { level:Uuid; width:long; depth:long; }

table AddWall { wall:Wall; }
table MoveWallEnd { wall:Uuid; end:WallEnd = End; to:PointMm; }
table SetWallThickness { wall:Uuid; thickness:long; }
table SetWallHeight { wall:Uuid; height:long; }
table SetWallLocationLine { wall:Uuid; location_line:LocationLine = Center; }
table RemoveWall { wall:Uuid; }
table SetWallUnit { wall:Uuid; length:long; width:long; height:long; }

table AddOpening { opening:Opening; }
table MoveOpening { opening:Uuid; offset:long; }
table ResizeOpening { opening:Uuid; width:long; height:long; }
table SetOpeningSill { opening:Uuid; sill:long; }
table SetOpeningKind { opening:Uuid; kind:OpeningKind = Window; }
table RemoveOpening { opening:Uuid; }

// A Luau file from content/ (docs/adr/0005); the name is the file's stem.
table Script {
  name:string;
  source:string;
}

// Replaces the norms and rules the take-off runs with. A script that does not compile fails the
// command and keeps the previous content.
table LoadContent {
  norms:[Script];
  rules:[Script];
}

// An opening where the user tapped: in the wall on `level` nearest to `at`, if one lies within
// `reach`, centred on the tap and moved along the wall to fit between its ends. Runs as
// AddOpening. Fails with NoWall when no wall is that near and DoesNotFit when the opening is
// wider than the wall.
table PlaceOpening {
  level:Uuid;
  at:PointMm;
  reach:long;
  width:long;
  height:long;
  sill:long;
  kind:OpeningKind = Window;
}

// What the user tapped on `level`: an opening or wall under `at`, else the nearest within
// `reach`, openings first. Changes nothing; the result's `picked` names the element and is absent
// when nothing is that near.
table Pick {
  level:Uuid;
  at:PointMm;
  reach:long;
}

enum Turn:ubyte { Left = 0, Straight = 1, Right = 2 }

// A touch on `level` while a wall is drawn (docs/adr/0011). Changes nothing; the result's `aimed`
// says where the wall would end. `from` is the wall's start, absent while its first point is
// placed; `reach` is how far from the finger still counts as touched; a free coordinate falls on
// a multiple of `grid`; `square` holds the wall to the plan's axes.
table Aim {
  level:Uuid;
  from:PointMm;
  at:PointMm;
  reach:long;
  grid:long;
  square:bool;
}

// A wall of a typed length from `from`, turning from the wall that ended there; that wall started
// at `before`, absent for the first wall of a run, which goes to the right of the plan. Changes
// nothing; the result's `aimed` says where the wall ends.
table AimMeasured {
  level:Uuid;
  from:PointMm;
  before:PointMm;
  turn:Turn = Straight;
  length:long;
}

// The end of a wall that stays when the wall gets a length. `Joined` leaves it to the plan: the
// end joined to other walls when the other end is free, so a partition grows from the wall it
// stands against; else the start.
enum FixedEnd:ubyte { Joined = 0, Start = 1, End = 2 }

// Gives the wall a length along its line and makes it exact. Its `fixed` end stays; what is
// joined to the other end goes with it so that walls keep their direction. Runs as MoveWallEnd
// commands in one undo step; changes nothing when the length is not positive (ZeroLength), a
// point would leave the plan (OffPlan), or a joined wall would vanish, turn back on itself or
// come off the wall it stands against (BreaksJoin).
table SetWallLength {
  wall:Uuid;
  length:long;
  fixed:FixedEnd = Joined;
}

// A stroke drawn with a finger, read as walls (docs/adr/0012, engine/geom/sketch.h). `points` is
// the finger's path in the order drawn; `reach`, `grid` and `square` mean what they do for Aim.
// `wall` is the wall to build, on its level; its start, end and exact are not read. Runs as
// AddWall commands in one undo step, each wall not exact. Changes nothing when the stroke gives
// no wall (ZeroLength), a point lies off the plan (OffPlan) or the wall cannot be built.
table AddSketch {
  wall:Wall;
  points:[PointMm];
  reach:long;
  grid:long;
  square:bool;
}

// Replaces the open model with a saved job's elements (docs/adr/0007) and starts an empty log
// with no undo or redo. `clock` is the newest stamp in the job's log; later stamps sort after it.
// Fails with CorruptData, changing nothing, when an element is invalid, an id repeats, or a wall
// or opening refers to a missing level or wall.
table OpenModel {
  elements:[ElementChange];
  clock:ulong;
}

// Commands between BeginGesture and EndGesture fold into one undo step.
table BeginGesture {}
table EndGesture {}
table Undo {}
table Redo {}

union Command {
  AddLevel,
  SetLevelElevation,
  SetLevelHeight,
  RemoveLevel,
  AddWall,
  MoveWallEnd,
  SetWallThickness,
  SetWallHeight,
  SetWallLocationLine,
  RemoveWall,
  AddOpening,
  MoveOpening,
  ResizeOpening,
  SetOpeningSill,
  SetOpeningKind,
  RemoveOpening,
  BeginGesture,
  EndGesture,
  Undo,
  Redo,
  LoadContent,
  PlaceOpening,
  OpenModel,
  Pick,
  SetWallUnit,
  SetLevelRingBeam,
  SetLevelJunctionMeshes,
  SetCondition,
  SetLevelFooting,
  Aim,
  AimMeasured,
  SetWallLength,
  AddSketch,
}

table CommandEntry {
  command:Command;
}

// Commands run in order; one that fails changes nothing and the rest still run.
table Request {
  version:uint = 1;
  commands:[CommandEntry];
}

enum ErrorCode:ubyte {
  None = 0,
  NotFound = 1,
  OffPlan = 2,
  ZeroLength = 3,
  ThicknessNotPositive = 4,
  HeightNotPositive = 5,
  WidthNotPositive = 6,
  OffsetNegative = 7,
  SillNegative = 8,
  BearingNegative = 9,
  UnitSizeNotPositive = 10,
  JointNegative = 11,
  RuleSyntax = 12,
  RuleFailed = 13,
  RuleOutput = 14,
  GestureOpen = 15,
  NothingToUndo = 16,
  NothingToRedo = 17,
  CorruptData = 18,
  UnsupportedVersion = 19,
  Internal = 20,
  NoWall = 21,
  DoesNotFit = 22,
  ConditionOutOfRange = 23,
  BreaksJoin = 24,
}

// The aimed point lined up with a wall end: a line from that end to the point.
struct Guide {
  from:PointMm;
  to:PointMm;
}

// Where a wall being drawn would end (engine/geom/editing.h).
table Aimed {
  point:PointMm;
  length:long;     // from the wall's start along its line; 0 for a first point
  guides:[Guide];
  meets:bool;      // the point is a wall end or lies in a wall, so a wall ending here joins the plan
}

table CommandResult {
  error:ErrorCode = None;
  message:string;  // English context for logs; the app shows translated text for `error`
  created:Uuid;    // the element the command created, if any
  picked:Uuid;     // the element a Pick found, if any
  aimed:Aimed;     // the answer to an Aim or AimMeasured
}

union Element { Level, Wall, Opening, Conditions }

// What produced an operation-log group (engine/core/op.h).
enum CommandKind:ubyte {
  AddLevel = 0,
  SetLevelElevation = 1,
  SetLevelHeight = 2,
  RemoveLevel = 3,
  AddWall = 4,
  MoveWallEnd = 5,
  SetWallThickness = 6,
  SetWallHeight = 7,
  SetWallLocationLine = 8,
  RemoveWall = 9,
  AddOpening = 10,
  MoveOpening = 11,
  ResizeOpening = 12,
  SetOpeningSill = 13,
  SetOpeningKind = 14,
  RemoveOpening = 15,
  Undo = 16,
  Redo = 17,
  SetWallUnit = 18,
  SetLevelRingBeam = 19,
  SetLevelJunctionMeshes = 20,
  SetCondition = 21,
  SetLevelFooting = 22,
  SetWallExact = 23,
}

enum LevelField:ubyte {
  Elevation = 0,
  Height = 1,
  RingBeam = 2,
  JunctionMeshes = 3,
  FootingWidth = 4,
  FootingDepth = 5,
}
enum WallField:ubyte {
  Start = 0,
  End = 1,
  Thickness = 2,
  Height = 3,
  LocationLine = 4,
  UnitLength = 5,
  UnitWidth = 6,
  UnitHeight = 7,
  Exact = 8,
}
enum OpeningField:ubyte { Offset = 0, Width = 1, Height = 2, Sill = 3, Kind = 4 }

// Property-level changes (engine/core/op.h). Create and delete carry the whole element.
table CreateOp { id:Uuid; element:Element; }
table DeleteOp { id:Uuid; element:Element; }
// JunctionMeshes uses 0 and 1; the other fields millimetres.
table SetLevelFieldOp { id:Uuid; field:LevelField; before:long; after:long; }
// Start and End use the points; LocationLine its code, Exact 0 and 1 and the other fields
// millimetres in before and after.
table SetWallFieldOp {
  id:Uuid;
  field:WallField;
  before:long;
  after:long;
  before_point:PointMm;
  after_point:PointMm;
}
// Kind uses its code; the other fields millimetres.
table SetOpeningFieldOp { id:Uuid; field:OpeningField; before:long; after:long; }

table SetConditionsFieldOp { id:Uuid; field:ConditionsField; before:long; after:long; }

union Op {
  CreateOp,
  DeleteOp,
  SetLevelFieldOp,
  SetWallFieldOp,
  SetOpeningFieldOp,
  SetConditionsFieldOp,
}

table OpEntry {
  op:Op;
}

// One group of the operation log, as the job file stores it: a buffer of its own with the
// identifier "OTVG" (docs/adr/0007). `origin` is the group an undo reverts or a redo repeats.
table OpGroup {
  version:uint = 1;
  id:Uuid;
  kind:CommandKind = AddLevel;
  hlc:ulong;
  device:Uuid;
  origin:Uuid;
  ops:[OpEntry];
}

// A group the request appended to the log, with the columns the job file indexes.
table LogEntry {
  id:Uuid;
  kind:CommandKind = AddLevel;
  hlc:ulong;
  device:Uuid;
  origin:Uuid;
  ops:[ubyte] (nested_flatbuffer: "OpGroup", force_align: 8);
}

// A point of derived geometry, in metres.
struct PointM {
  x:double;
  y:double;
}

// A wall's plan outline after joining, counter-clockwise (engine/geom).
table WallOutline {
  wall:Uuid;
  level:Uuid;
  points:[PointM];
  length:long;  // along the location line, rounded to the millimetre, for dimensions
}

// An opening's plan outline through its wall, counter-clockwise (engine/geom).
table OpeningOutline {
  opening:Uuid;
  level:Uuid;
  kind:OpeningKind = Window;
  points:[PointM];
}

enum IssueKind:ubyte {
  OpeningOutsideWall = 0,  // past the wall's ends, below its base or above its top
  OpeningOverlap = 1,      // over another opening in the same wall
  OpeningWithoutWall = 2,
  ShortBearing = 3,        // the lintel runs past the wall's end or into another opening
  NoRoomForLintel = 4,     // the lintel rises above the wall's top
  WallOverlap = 5,         // walls along one line from a point, or one inside another
  SharpAngle = 6,          // walls meet at so small an angle that their ends are cut square
  MaterialNotChosen = 7,   // the wall has no masonry unit, so it is not in the take-off
  // The norm asks for seismic detailing the level does not have (docs/adr/0008); these name the
  // level only.
  RingBeamMissing = 8,
  JunctionMeshesMissing = 9,
}

// Something in the model a builder has to fix (engine/geom, engine/takeoff). An opening or
// material issue names the element; a wall join issue has the point where the walls meet.
table Issue {
  kind:IssueKind = OpeningOutsideWall;
  element:Uuid;
  level:Uuid;
  at:PointMm;
}

enum Unit:ubyte { Piece = 0, Metre = 1, SquareMetre = 2, CubicMetre = 3, Kilogram = 4 }

// A material line from a content rule (engine/takeoff).
table QuantityLine {
  rule:string;
  item:string;
  unit:Unit = Piece;
  amount:double;
}

// An element's new value, or its deletion when `element` is NONE.
table ElementChange {
  id:Uuid;
  element:Element;
}

table Response {
  version:uint = 1;
  results:[CommandResult];  // one per command, in order
  changes:[ElementChange];  // sorted by id
  can_undo:bool;
  can_redo:bool;
  // Present only when the model or the content changed since the previous response.
  outlines:[WallOutline];   // every wall on every level
  takeoff:[QuantityLine];   // absent until content is loaded
  takeoff_error:ErrorCode = None;
  takeoff_message:string;
  openings:[OpeningOutline];  // with the outlines: every opening in a wall
  log:[LogEntry];             // groups appended to the operation log, in order
  issues:[Issue];             // with the outlines; opening issues once content is loaded
}

root_type Request;
