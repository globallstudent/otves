// The contract between the Kotlin app and the C++ engine (docs/adr/0006). Add fields only at
// the end of a table, with a default; never renumber, retype or remove one: deprecate it. Enum
// values never change once released. Lengths are whole millimetres.

namespace otves.schema;

file_identifier "OTVS";

struct Uuid {
  high:ulong;
  low:ulong;
}

struct PointMm {
  x:long;
  y:long;
}

enum LocationLine:ubyte { Center = 0, LeftFace = 1, RightFace = 2 }

enum OpeningKind:ubyte { Window = 0, Door = 1, Empty = 2 }

enum WallEnd:ubyte { Start = 0, End = 1 }

table Level {
  elevation:long;
  height:long;
  ring_beam:long;        // height of the beam on the load-bearing walls; 0 for none (docs/adr/0008)
  junction_meshes:bool;  // meshes where load-bearing walls meet
  // The section of the strip footing under the load-bearing walls; both 0 for none (docs/adr/0010).
  footing_width:long;
  footing_depth:long;
}

table Wall {
  level:Uuid;
  start:PointMm;
  end:PointMm;
  thickness:long;
  height:long;
  location_line:LocationLine = Center;
  // The masonry unit as laid; all 0 until chosen (docs/adr/0008).
  unit_length:long;
  unit_width:long;
  unit_height:long;
  // Whether the length was typed or measured. A wall read from a sketch is not, until it gets a
  // length (docs/adr/0012).
  exact:bool = true;
  // What kind of wall this is (docs/adr/0014); absent for a wall with no type. A wall with a
  // type has thickness 0 and no unit: its type decides them.
  type:Uuid;
  // The type's layers start from the wall's right face, looking from start to end, or from its
  // left one when this is set.
  mirrored:bool;
}

// What a wall is for. Exterior and bearing walls carry load; partitions do not.
enum WallRole:ubyte { Exterior = 0, Bearing = 1, Partition = 2 }

// A kind of wall the job builds with (docs/adr/0014); its layers are WallLayer elements.
table WallType {
  role:WallRole = Exterior;
}

enum LayerFunction:ubyte {
  Structure = 0,   // the masonry that carries the wall
  Insulation = 1,  // bought by area
  Facing = 2,      // masonry laid in front of the wall
  Gap = 3,         // air
}

// One layer of a wall type. Layers run from the wall's outer face in, in the order of their
// positions. Only structure and facing are laid from a unit; all 0 until chosen.
table WallLayer {
  type:Uuid;
  position:long;
  function:LayerFunction = Structure;
  thickness:long;
  unit_length:long;
  unit_width:long;
  unit_height:long;
}

// What a room is used as (engine/core/room.h). The app writes the name in the builder's language.
enum RoomKind:ubyte {
  Room = 0,
  LivingRoom = 1,
  KitchenLiving = 2,
  Kitchen = 3,
  Dining = 4,
  Bedroom = 5,
  Children = 6,
  Study = 7,
  Hall = 8,
  Corridor = 9,
  Bathroom = 10,  // a bath and a toilet in one room
  Bath = 11,
  Toilet = 12,
  Boiler = 13,
  Storage = 14,
  Wardrobe = 15,
  Veranda = 16,
  Garage = 17,
  Tambour = 18,
}

// A name for the space of `level` that holds `anchor` (docs/adr/0015).
table Room {
  level:Uuid;
  anchor:PointMm;
  kind:RoomKind = Room;
}

// How a door hangs (docs/adr/0017): the edge its leaf hangs on, the near one being towards the
// wall's start, and the side of the wall it opens to, looking from the wall's start.
enum Hinge:ubyte { Near = 0, Far = 1 }
enum Swing:ubyte { Left = 0, Right = 1 }

table Opening {
  wall:Uuid;
  offset:long;
  width:long;
  height:long;
  sill:long;
  kind:OpeningKind = Window;
  hinge:Hinge = Near;
  swing:Swing = Left;
}

// What the job is estimated under (docs/adr/0009); -1 leaves a value to the norm default.
table Conditions {
  seismic_intensity:long = -1;  // points
  cement_grade:long = -1;       // 400 for ПЦ400
  mortar_grade:long = -1;       // 100 for М100
  unit_waste:long = -1;         // per mille
  mortar_waste:long = -1;       // per mille
}

enum ConditionsField:ubyte {
  SeismicIntensity = 0,
  CementGrade = 1,
  MortarGrade = 2,
  UnitWaste = 3,
  MortarWaste = 4,
}

// Sets one condition, creating the job's conditions when it has none.
table SetCondition { field:ConditionsField; value:long = -1; }

table AddLevel { level:Level; }
table SetLevelElevation { level:Uuid; elevation:long; }
table SetLevelHeight { level:Uuid; height:long; }
table RemoveLevel { level:Uuid; }
table SetLevelRingBeam { level:Uuid; height:long; }
table SetLevelJunctionMeshes { level:Uuid; meshes:bool; }
table SetLevelFooting { level:Uuid; width:long; depth:long; }

table AddWall { wall:Wall; }
table MoveWallEnd { wall:Uuid; end:WallEnd = End; to:PointMm; }
table SetWallThickness { wall:Uuid; thickness:long; }
table SetWallHeight { wall:Uuid; height:long; }
table SetWallLocationLine { wall:Uuid; location_line:LocationLine = Center; }
table RemoveWall { wall:Uuid; }
table SetWallUnit { wall:Uuid; length:long; width:long; height:long; }

// A new wall type with its layers from the outer face in; the layers' type and position are
// not read. The result's `created` is the type.
table AddWallType { role:WallRole = Exterior; layers:[WallLayer]; }
table SetWallTypeRole { type:Uuid; role:WallRole = Exterior; }
// A layer's thickness and unit; all 0 clears the unit. Every wall of its type changes with it.
table SetWallLayer { layer:Uuid; thickness:long; unit_length:long; unit_width:long; unit_height:long; }
// Makes the wall one of the type's kind and drops its own thickness and unit.
table SetWallType { wall:Uuid; type:Uuid; }
table SetWallMirrored { wall:Uuid; mirrored:bool; }

// Names the space that holds the room's anchor (docs/adr/0015). Whether a space is there is not
// checked: the response's issues say when it is not.
table AddRoom { room:Room; }
table MoveRoom { room:Uuid; anchor:PointMm; }
table SetRoomKind { room:Uuid; kind:RoomKind = Room; }
// Takes the name away; the space stays.
table RemoveRoom { room:Uuid; }

table AddOpening { opening:Opening; }
table MoveOpening { opening:Uuid; offset:long; }
table ResizeOpening { opening:Uuid; width:long; height:long; }
table SetOpeningSill { opening:Uuid; sill:long; }
table SetOpeningKind { opening:Uuid; kind:OpeningKind = Window; }
table RemoveOpening { opening:Uuid; }
table SetOpeningHinge { opening:Uuid; hinge:Hinge = Near; }
table SetOpeningSwing { opening:Uuid; swing:Swing = Left; }
// Puts the opening in the middle of the side of the room it is in, or of its wall when no room
// is there (docs/adr/0017). Runs as MoveOpening.
table CenterOpening { opening:Uuid; }

// A Luau file from content/ (docs/adr/0005); the name is the file's stem.
table Script {
  name:string;
  source:string;
}

// Replaces the norms and rules the take-off runs with. A script that does not compile fails the
// command and keeps the previous content.
table LoadContent {
  norms:[Script];
  rules:[Script];
}

// An opening where the user tapped: in the wall on `level` nearest to `at`, if one lies within
// `reach`, centred on the tap and moved along the wall to fit between its ends. Runs as
// AddOpening. Fails with NoWall when no wall is that near and DoesNotFit when the opening is
// wider than the wall.
table PlaceOpening {
  level:Uuid;
  at:PointMm;
  reach:long;
  width:long;
  height:long;
  sill:long;
  kind:OpeningKind = Window;
}

// What the user tapped on `level`: an opening or wall under `at`, else the nearest within
// `reach`, openings first. Changes nothing; the result's `picked` names the element and is absent
// when nothing is that near. Then the result's `space` is the space `at` lies in, if the walls
// close one there (docs/adr/0015).
table Pick {
  level:Uuid;
  at:PointMm;
  reach:long;
}

enum Turn:ubyte { Left = 0, Straight = 1, Right = 2 }

// A touch on `level` while a wall is drawn (docs/adr/0011). Changes nothing; the result's `aimed`
// says where the wall would end. `from` is the wall's start, absent while its first point is
// placed; `reach` is how far from the finger still counts as touched; a free coordinate falls on
// a multiple of `grid`; `square` holds the wall to the plan's axes.
table Aim {
  level:Uuid;
  from:PointMm;
  at:PointMm;
  reach:long;
  grid:long;
  square:bool;
}

// A wall of a typed length from `from`, turning from the wall that ended there; that wall started
// at `before`, absent for the first wall of a run, which goes to the right of the plan. Changes
// nothing; the result's `aimed` says where the wall ends.
table AimMeasured {
  level:Uuid;
  from:PointMm;
  before:PointMm;
  turn:Turn = Straight;
  length:long;
}

// The end of a wall that stays when the wall gets a length. `Joined` leaves it to the plan: the
// end joined to other walls when the other end is free, so a partition grows from the wall it
// stands against; else the start.
enum FixedEnd:ubyte { Joined = 0, Start = 1, End = 2 }

// Gives the wall a length along its line and makes it exact. Its `fixed` end stays; what is
// joined to the other end goes with it so that walls keep their direction. Runs as MoveWallEnd
// commands in one undo step; changes nothing when the length is not positive (ZeroLength), a
// point would leave the plan (OffPlan), or a joined wall would vanish, turn back on itself or
// come off the wall it stands against (BreaksJoin).
table SetWallLength {
  wall:Uuid;
  length:long;
  fixed:FixedEnd = Joined;
}

// A stroke drawn with a finger, read as walls (docs/adr/0012, engine/geom/sketch.h). `points` is
// the finger's path in the order drawn; `reach`, `grid` and `square` mean what they do for Aim.
// `wall` is the wall to build, on its level; its start, end and exact are not read. Runs as
// AddWall commands in one undo step, each wall not exact. Changes nothing when the stroke gives
// no wall (ZeroLength), a point lies off the plan (OffPlan) or the wall cannot be built.
table AddSketch {
  wall:Wall;
  points:[PointMm];
  reach:long;
  grid:long;
  square:bool;
}

// What a text of a drawing says (engine/drafting/plan.h).
enum TextKind:ubyte {
  Length = 0,       // a wall's length
  AboutLength = 1,  // one that nobody has typed or measured
  RoomName = 2,     // a room's name: `value` is its RoomKind
  RoomArea = 3,     // a space's floor: `value` is its area in cm²
  // Sizes in millimetres (docs/adr/0016). All but Overall are handles for SetDimension.
  Overall = 4,       // the plan from outer face to outer face
  Clear = 5,         // across the space in focus, between two of its walls
  Pier = 6,          // a piece of wall between a corner or an opening and the next opening
  OpeningWidth = 7,  // an opening's width
  // An opening's mark (docs/adr/0017): `value` is its number among the marks of its kind,
  // which the text's kind names so the app can write its letters.
  WindowMark = 8,
  DoorMark = 9,
  EmptyMark = 10,
}

// The drawing of `level` (docs/adr/0013). Changes nothing; the result's `drawing` holds it.
// `text_height` and `digit_width` say how big the app's label text is on the plan at its zoom:
// the height of a line and the width of a digit, in millimetres. The engine places labels with
// them and leaves out the ones that do not fit. The space that holds `focus` is drawn with its
// sizes in place of its name (docs/adr/0016).
table Draw {
  level:Uuid;
  text_height:long;
  digit_width:long;
  focus:PointMm;
  // The selected element: an opening is drawn with the chain of the side it is in.
  selected:Uuid;
}

// Gives a size on the plan a typed value (docs/adr/0016). `kind`, `element`, `from` and
// `forward` are those of the text that showed the size; `value` is in millimetres. An opening's
// width keeps its near edge; a piece of wall moves the opening it leads to; a wall's length
// runs as SetWallLength. A clear size moves the wall `element` so that it stands `value` from
// the wall `other`, face to face, with what is joined to it; the app may swap the two the text
// named to move the other wall. One undo step. Fails with DoesNotFit when the opening would
// leave its wall or the walls do not face each other, and with CorruptData for a kind that is
// no handle.
table SetDimension {
  kind:TextKind = Length;
  element:Uuid;
  from:long;
  forward:bool;
  value:long;
  other:Uuid;
}

// Replaces the open model with a saved job's elements (docs/adr/0007) and starts an empty log
// with no undo or redo. `clock` is the newest stamp in the job's log; later stamps sort after it.
// Fails with CorruptData, changing nothing, when an element is invalid, an id repeats, or a wall,
// room or opening refers to a missing level or wall.
table OpenModel {
  elements:[ElementChange];
  clock:ulong;
}

// Commands between BeginGesture and EndGesture fold into one undo step.
table BeginGesture {}
table EndGesture {}
table Undo {}
table Redo {}

union Command {
  AddLevel,
  SetLevelElevation,
  SetLevelHeight,
  RemoveLevel,
  AddWall,
  MoveWallEnd,
  SetWallThickness,
  SetWallHeight,
  SetWallLocationLine,
  RemoveWall,
  AddOpening,
  MoveOpening,
  ResizeOpening,
  SetOpeningSill,
  SetOpeningKind,
  RemoveOpening,
  BeginGesture,
  EndGesture,
  Undo,
  Redo,
  LoadContent,
  PlaceOpening,
  OpenModel,
  Pick,
  SetWallUnit,
  SetLevelRingBeam,
  SetLevelJunctionMeshes,
  SetCondition,
  SetLevelFooting,
  Aim,
  AimMeasured,
  SetWallLength,
  AddSketch,
  Draw,
  AddWallType,
  SetWallTypeRole,
  SetWallLayer,
  SetWallType,
  SetWallMirrored,
  AddRoom,
  MoveRoom,
  SetRoomKind,
  RemoveRoom,
  SetDimension,
  SetOpeningHinge,
  SetOpeningSwing,
  CenterOpening,
}

table CommandEntry {
  command:Command;
}

// Commands run in order; one that fails changes nothing and the rest still run.
table Request {
  version:uint = 1;
  commands:[CommandEntry];
}

enum ErrorCode:ubyte {
  None = 0,
  NotFound = 1,
  OffPlan = 2,
  ZeroLength = 3,
  ThicknessNotPositive = 4,
  HeightNotPositive = 5,
  WidthNotPositive = 6,
  OffsetNegative = 7,
  SillNegative = 8,
  BearingNegative = 9,
  UnitSizeNotPositive = 10,
  JointNegative = 11,
  RuleSyntax = 12,
  RuleFailed = 13,
  RuleOutput = 14,
  GestureOpen = 15,
  NothingToUndo = 16,
  NothingToRedo = 17,
  CorruptData = 18,
  UnsupportedVersion = 19,
  Internal = 20,
  NoWall = 21,
  DoesNotFit = 22,
  ConditionOutOfRange = 23,
  BreaksJoin = 24,
  TypeDecides = 25,  // a thickness or unit given to a wall whose type decides them
}

// The aimed point lined up with a wall end: a line from that end to the point.
struct Guide {
  from:PointMm;
  to:PointMm;
}

// Where a wall being drawn would end (engine/geom/editing.h).
table Aimed {
  point:PointMm;
  length:long;     // from the wall's start along its line; 0 for a first point
  guides:[Guide];
  meets:bool;      // the point is a wall end or lies in a wall, so a wall ending here joins the plan
}

// A point of derived geometry, in metres.
struct PointM {
  x:double;
  y:double;
}

// What a polygon of a drawing is filled as and a line is drawn as (engine/drafting/plan.h). The
// app maps each to a paint; one it does not know is not painted.
enum Fill:ubyte {
  None = 0,
  Wall = 1,      // masonry
  Unchosen = 2,  // masonry with no material yet
  Gap = 3,       // what an opening leaves of its wall
  Facing = 4,    // masonry laid in front of the wall
  Insulation = 5,
  Floor = 6,     // a space the walls close
}

enum Stroke:ubyte {
  None = 0,
  WallEdge = 1,
  Below = 2,  // a wall of the level below
  Frame = 3,  // a window's faces and glazing
  Leaf = 4,   // a door's leaf and swing
  Layer = 5,  // where two layers of a wall meet
  Dimension = 6,  // a dimension line, its ticks and the lines that lead to it
  Chain = 7,      // the same for the sizes of the space in focus
}

// Every primitive names the element it draws; absent for what cannot be picked.
table DrawnPolygon {
  element:Uuid;
  fill:Fill = None;
  stroke:Stroke = None;  // of its outline
  points:[PointM];
}

table DrawnLine {
  element:Uuid;
  stroke:Stroke = None;
  from:PointM;
  to:PointM;
}

// Around `centre` from `from` to `to`, counter-clockwise; both lie at one radius.
table DrawnArc {
  element:Uuid;
  stroke:Stroke = None;
  centre:PointM;
  from:PointM;
  to:PointM;
}

// A number in millimetres, or what `kind` says, written with its middle at `at`, along the unit
// direction `along`, which never points to the left or straight down. `fit` is the room there is
// for it along that direction, in metres; a text wider than that is left out. Zero for a text
// the engine fitted itself.
table DrawnText {
  element:Uuid;
  kind:TextKind = Length;
  value:long;
  at:PointM;
  along:PointM;
  fit:double;
  // For a size that is a handle (docs/adr/0016): `element` is the opening or wall a typed value
  // changes. For a piece of wall, `from` is where its fixed end lies along the opening's wall
  // from that wall's start, in millimetres, and `forward` whether the opening lies further
  // along the wall than that end.
  from:long;
  forward:bool;
  // For a clear size: the wall at its other end. `element` is the wall at its far end, to the
  // right or the top of the plan. Both absent when a typed value cannot move a wall there.
  other:Uuid;
}

// One level as a display list (docs/adr/0013), in plan metres: painted in this order, each list
// in the order given.
table Drawing {
  polygons:[DrawnPolygon];
  lines:[DrawnLine];
  arcs:[DrawnArc];
  texts:[DrawnText];
}

// A closed outline in plan metres.
table Ring {
  points:[PointM];
}

// The space under a picked point (docs/adr/0015): the floor the walls close there.
table PickedSpace {
  room:Uuid;             // the room that names it; absent for a space with no name
  kind:RoomKind = Room;  // of that room
  area:double;           // m², less what stands free inside
  perimeter:double;      // m, round what stands free inside too
  outline:[PointM];      // counter-clockwise
  islands:[Ring];        // clockwise: what stands free inside
}

table CommandResult {
  error:ErrorCode = None;
  message:string;  // English context for logs; the app shows translated text for `error`
  created:Uuid;    // the element the command created, if any
  picked:Uuid;     // the element a Pick found, if any
  aimed:Aimed;     // the answer to an Aim or AimMeasured
  drawing:Drawing;  // the answer to a Draw
  space:PickedSpace;  // the space a Pick found when no element was there
}

union Element { Level, Wall, Opening, Conditions, WallType, WallLayer, Room }

// What produced an operation-log group (engine/core/op.h).
enum CommandKind:ubyte {
  AddLevel = 0,
  SetLevelElevation = 1,
  SetLevelHeight = 2,
  RemoveLevel = 3,
  AddWall = 4,
  MoveWallEnd = 5,
  SetWallThickness = 6,
  SetWallHeight = 7,
  SetWallLocationLine = 8,
  RemoveWall = 9,
  AddOpening = 10,
  MoveOpening = 11,
  ResizeOpening = 12,
  SetOpeningSill = 13,
  SetOpeningKind = 14,
  RemoveOpening = 15,
  Undo = 16,
  Redo = 17,
  SetWallUnit = 18,
  SetLevelRingBeam = 19,
  SetLevelJunctionMeshes = 20,
  SetCondition = 21,
  SetLevelFooting = 22,
  SetWallExact = 23,
  AddWallType = 24,
  SetWallTypeRole = 25,
  SetWallLayer = 26,
  SetWallType = 27,
  SetWallMirrored = 28,
  AddRoom = 29,
  MoveRoom = 30,
  SetRoomKind = 31,
  RemoveRoom = 32,
  SetOpeningHinge = 33,
  SetOpeningSwing = 34,
}

enum LevelField:ubyte {
  Elevation = 0,
  Height = 1,
  RingBeam = 2,
  JunctionMeshes = 3,
  FootingWidth = 4,
  FootingDepth = 5,
}
enum WallField:ubyte {
  Start = 0,
  End = 1,
  Thickness = 2,
  Height = 3,
  LocationLine = 4,
  UnitLength = 5,
  UnitWidth = 6,
  UnitHeight = 7,
  Exact = 8,
  Type = 9,
  Mirrored = 10,
}
enum WallTypeField:ubyte { Role = 0 }
enum WallLayerField:ubyte { Thickness = 0, UnitLength = 1, UnitWidth = 2, UnitHeight = 3 }
enum OpeningField:ubyte { Offset = 0, Width = 1, Height = 2, Sill = 3, Kind = 4, Hinge = 5, Swing = 6 }
enum RoomField:ubyte { Anchor = 0, Kind = 1 }

// Property-level changes (engine/core/op.h). Create and delete carry the whole element.
table CreateOp { id:Uuid; element:Element; }
table DeleteOp { id:Uuid; element:Element; }
// JunctionMeshes uses 0 and 1; the other fields millimetres.
table SetLevelFieldOp { id:Uuid; field:LevelField; before:long; after:long; }
// Start and End use the points and Type the ids, absent for no type; LocationLine its code,
// Exact and Mirrored 0 and 1 and the other fields millimetres in before and after.
table SetWallFieldOp {
  id:Uuid;
  field:WallField;
  before:long;
  after:long;
  before_point:PointMm;
  after_point:PointMm;
  before_id:Uuid;
  after_id:Uuid;
}
// Kind, Hinge and Swing use their codes; the other fields millimetres.
table SetOpeningFieldOp { id:Uuid; field:OpeningField; before:long; after:long; }

table SetConditionsFieldOp { id:Uuid; field:ConditionsField; before:long; after:long; }

// Role uses its code.
table SetWallTypeFieldOp { id:Uuid; field:WallTypeField; before:long; after:long; }
// Millimetres.
table SetWallLayerFieldOp { id:Uuid; field:WallLayerField; before:long; after:long; }
// Anchor uses the points; Kind its code in before and after.
table SetRoomFieldOp {
  id:Uuid;
  field:RoomField;
  before:long;
  after:long;
  before_point:PointMm;
  after_point:PointMm;
}

union Op {
  CreateOp,
  DeleteOp,
  SetLevelFieldOp,
  SetWallFieldOp,
  SetOpeningFieldOp,
  SetConditionsFieldOp,
  SetWallTypeFieldOp,
  SetWallLayerFieldOp,
  SetRoomFieldOp,
}

table OpEntry {
  op:Op;
}

// One group of the operation log, as the job file stores it: a buffer of its own with the
// identifier "OTVG" (docs/adr/0007). `origin` is the group an undo reverts or a redo repeats.
table OpGroup {
  version:uint = 1;
  id:Uuid;
  kind:CommandKind = AddLevel;
  hlc:ulong;
  device:Uuid;
  origin:Uuid;
  ops:[OpEntry];
}

// A group the request appended to the log, with the columns the job file indexes.
table LogEntry {
  id:Uuid;
  kind:CommandKind = AddLevel;
  hlc:ulong;
  device:Uuid;
  origin:Uuid;
  ops:[ubyte] (nested_flatbuffer: "OpGroup", force_align: 8);
}

// A wall's plan outline after joining, counter-clockwise (engine/geom).
table WallOutline {
  wall:Uuid;
  level:Uuid;
  points:[PointM];
  length:long;  // along the location line, rounded to the millimetre, for dimensions
}

// An opening's plan outline through its wall, counter-clockwise (engine/geom).
table OpeningOutline {
  opening:Uuid;
  level:Uuid;
  kind:OpeningKind = Window;
  points:[PointM];
}

enum IssueKind:ubyte {
  OpeningOutsideWall = 0,  // past the wall's ends, below its base or above its top
  OpeningOverlap = 1,      // over another opening in the same wall
  OpeningWithoutWall = 2,
  ShortBearing = 3,        // the lintel runs past the wall's end or into another opening
  NoRoomForLintel = 4,     // the lintel rises above the wall's top
  WallOverlap = 5,         // walls along one line from a point, or one inside another
  SharpAngle = 6,          // walls meet at so small an angle that their ends are cut square
  MaterialNotChosen = 7,   // the wall has no masonry unit, so it is not in the take-off
  // The norm asks for seismic detailing the level does not have (docs/adr/0008); these name the
  // level only.
  RingBeamMissing = 8,
  JunctionMeshesMissing = 9,
  // A room's anchor lies in no space, or in a space an older room names (docs/adr/0015). These
  // name the room, with its anchor as the point.
  RoomWithoutSpace = 10,
  RoomSharesSpace = 11,
}

// Something in the model a builder has to fix (engine/geom, engine/takeoff). An opening or
// material issue names the element; a wall join issue has the point where the walls meet.
table Issue {
  kind:IssueKind = OpeningOutsideWall;
  element:Uuid;
  level:Uuid;
  at:PointMm;
}

enum Unit:ubyte { Piece = 0, Metre = 1, SquareMetre = 2, CubicMetre = 3, Kilogram = 4 }

// A material line from a content rule (engine/takeoff).
table QuantityLine {
  rule:string;
  item:string;
  unit:Unit = Piece;
  amount:double;
}

// An element's new value, or its deletion when `element` is NONE.
table ElementChange {
  id:Uuid;
  element:Element;
}

table Response {
  version:uint = 1;
  results:[CommandResult];  // one per command, in order
  changes:[ElementChange];  // sorted by id
  can_undo:bool;
  can_redo:bool;
  // Present only when the model or the content changed since the previous response.
  outlines:[WallOutline];   // every wall on every level
  takeoff:[QuantityLine];   // absent until content is loaded
  takeoff_error:ErrorCode = None;
  takeoff_message:string;
  openings:[OpeningOutline];  // with the outlines: every opening in a wall
  log:[LogEntry];             // groups appended to the operation log, in order
  issues:[Issue];             // with the outlines; opening issues once content is loaded
}

root_type Request;
